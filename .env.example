# Safe defaults for an internet-facing deployment.
APP_ENV=production
ENABLE_EMAIL_VERIFICATION=false
VERIFICATION_MODE=off
ENABLE_DOMAIN_VERIFICATION=false
ENABLE_SMTP_VERIFICATION=false
VERIFICATION_WORKERS=10
CONTENT_MODEL_ENABLED=false
CONTENT_MODEL_ARTIFACT=
CONTENT_MODEL_ARTIFACT_SHA256=
CONTENT_MODEL_USE_CACHE=false
CONTENT_MODEL_AUGMENT_SYNTHETIC=false
TRUSTED_AUTHSERV_IDS=
# Optional privacy-preserving sender history. Keep credentials in the deployment
# secret store; generate the HMAC key with: openssl rand -hex 32
SENDER_HISTORY_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENDER_HISTORY_HMAC_KEY=
SENDER_HISTORY_RETENTION_DAYS=90
SENDER_HISTORY_TIMEOUT_SECONDS=1.0
RATE_LIMIT_BUCKET_CAPACITY=4096
RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BYTES=65536
ALLOWED_HOSTS=*.vercel.app,*.onrender.com,localhost,127.0.0.1
# Comma-separated hostnames only; add both apex and www names when applicable.
CUSTOM_DOMAINS=

# Optional authenticated case workspace (disabled by default).
CASE_MANAGEMENT_ENABLED=false
CASE_STORE=upstash
CASE_WORKSPACE=production-cases
# Set JSON actor -> SHA-256 hash via deployment settings; never store raw tokens.
CASE_ANALYST_TOKEN_HASHES={}
# Optional dedicated Upstash connection; otherwise reuse UPSTASH_REDIS_REST_*.
CASE_REDIS_REST_URL=
CASE_REDIS_REST_TOKEN=
# Local persistent-host development only (absolute path outside static files):
CASE_DB_PATH=

# Experimental text-only Jev opinions; requires authenticated case workspace.
# Default off. Each manual request needs analyst consent to external processing.
# Configure provider-side spending limits before enabling; local 20-call budget
# is per server process lifetime, not a fleet-wide billing cap.
PHISHGUARD_JEV_ENABLED=false
TYPESAFE_API_KEY=
